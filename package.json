{
  "name": "@0pvalencia/academic-linter-mcp",
  "version": "0.1.0",
  "description": "MCP linter académico (APA/estructura) para JSON de Google Docs.",
  "type": "module",
  "bin": {
    "academic-linter-mcp": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "node --import tsx src/cli.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "0PValencia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0PValencia/academic-linter-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/0PValencia/academic-linter-mcp/issues"
  },
  "homepage": "https://github.com/0PValencia/academic-linter-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude",
    "ai",
    "academic",
    "apa",
    "linter",
    "google-docs"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cli.js"
}
